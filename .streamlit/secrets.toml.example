# Copy this file to .streamlit/secrets.toml and fill in real values.
# Do NOT commit the real secrets.toml; the .gitignore already excludes it.
#
# In Streamlit Community Cloud: paste the same contents into the app's
# "Settings -> Secrets" UI -- never push secrets.toml to GitHub.
#
# Only ONE backend block needs to be configured.
#
# ============================================================================
# OPTION A — Apps Script webhook (NO Google Cloud project required)
# ============================================================================
# Follow README.md -> "Deploy Option 1A" to deploy apps_script.gs as a
# Web App, then paste its deployment URL here.

[webhook]
url = "https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID_HERE/exec"

# ============================================================================
# OPTION B — Google Sheets API via service account (needs GCP project)
# ============================================================================
# [sheet]
# key = "REPLACE_WITH_YOUR_GOOGLE_SHEET_KEY"
# worksheet = "Submissions"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "your-gcp-project"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "service-account@your-gcp-project.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/service-account%40your-gcp-project.iam.gserviceaccount.com"
# universe_domain = "googleapis.com"

# ============================================================================
# OPTIONAL — Admin password for /?admin=1
# ============================================================================
# If you set this, the admin viewer at <app-url>/?admin=1 will prompt for it.
# If you omit it, the admin viewer is open (fine locally, not on the cloud).
# [admin]
# password = "pick-something-strong"
